{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "customManagers:githubActionsVersions",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Etc/UTC",
  "labels": [
    "dependencies"
  ],
  "semanticCommits": "enabled",
  "semanticCommitType": "build",
  "semanticCommitScope": "deps",
  "customManagers": [
    {
      "customType": "regex",
      "description": "GitHub runner labels in matrix entries and expressions, which the github-actions manager does not handle",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "\\bos: (?<depName>ubuntu|macos|windows)-(?<currentValue>[0-9.]+)\\b",
        "'(?<depName>ubuntu|macos|windows)-(?<currentValue>[0-9.]+)'"
      ],
      "datasourceTemplate": "github-runners"
    }
  ],
  "packageRules": [
    {
      "description": "GitHub Actions: weekly on Monday",
      "matchManagers": [
        "github-actions"
      ],
      "schedule": [
        "* 4-7 * * 1"
      ],
      "addLabels": [
        "github-actions"
      ]
    },
    {
      "description": "Group CodeQL actions",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "github/codeql-action",
        "github/codeql-action/**"
      ],
      "groupName": "codeql-action"
    },
    {
      "description": "Cargo: weekly on Friday",
      "matchManagers": [
        "cargo"
      ],
      "schedule": [
        "* 18-21 * * 5"
      ],
      "addLabels": [
        "rust"
      ]
    },
    {
      "description": "Group all patch updates of Rust crates",
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "groupName": "patch-updates"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "askama",
        "askama-*",
        "askama_*"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "groupName": "askama"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "anstyle",
        "anstyle-*"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "groupName": "anstyle"
    },
    {
